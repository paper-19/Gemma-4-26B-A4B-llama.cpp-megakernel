+    ggml_tensor * args[] = {
+        tokens, inp_pos,
+        inp_attn->get_kq_mask(), inp_attn->get_kq_mask_swa(),
+        inp_attn->get_k_idxs(), inp_attn->get_k_idxs_swa(),
+        inp_attn->get_v_idxs(), inp_attn->get_v_idxs_swa(),   // unused by the kernel; kept so the inputs are allocated
+        model.output_norm,   // a GPU weight: ggml's scheduler runs a node on the backend that holds its weights
+    };
