 }
+
+// GGML_CUDA_MEGAKERNEL=1: the single-token decode step as one custom node (false: not applicable, build the graph)
+bool llama_model_gemma4::graph::build_megakernel() {
+    // !ubatch.token: an input-embeddings batch (e.g. multimodal) takes the usual graph
+    if (!ubatch.token || n_tokens != 1 || n_outputs != 1 || !cparams.flash_attn || cparams.embeddings ||
+        model.per_layer_tok_embd || !model.output || n_layer != GGML_MEGAKERNEL_LAYERS || hparams.n_embd != 2816 ||
+        hparams.f_attention_scale != 1.0f) {
+        return false;
+    }
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & l = model.layers[il];
+        if (!hparams.has_kv(il) || l.wqkv || l.wq_s || l.wk_s || l.wv_s || l.wo_s || l.ffn_gate_s || l.ffn_up_s ||
+            l.ffn_down_s || l.ffn_up_exps_s || l.ffn_gate_exps_s || !l.ffn_gate_up_exps || !l.ffn_gate_inp ||
+            model.get_rope_freq_scale(cparams, il) != 1.0f) {
+            return false;
+        }
+    }
+    const auto * mctx_cur = static_cast<const llama_kv_cache_iswa_context *>(mctx);
+
+    // inputs: token ids, positions, the attention masks and destination cells of both caches
+    auto inp_tok = std::make_unique<llm_graph_input_mk_tokens>();
+    inp_tok->tokens = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_tokens);
+    ggml_set_input(inp_tok->tokens);
+    cb(inp_tok->tokens, "inp_tokens", -1);
+    res->t_inp_tokens = inp_tok->tokens;
+    ggml_tensor * tokens = inp_tok->tokens;
+    res->add_input(std::move(inp_tok));
+    ggml_tensor * inp_pos = build_inp_pos();
+    auto * inp_attn = build_attn_inp_kv_iswa();
+
+    // the descriptor: weights and cache tensors, one object per cache (the node's userdata must outlive the graph) and
+    // refilled at every build: a context created after another was freed can get the same tensor addresses, and a
+    // descriptor kept from then would point at the freed context's cache
+    static std::mutex mtx;
+    static std::map<const void *, std::unique_ptr<ggml_megakernel_desc>> descs;
+    ggml_tensor * k0 = mctx_cur->get_swa()->get_k(ctx0, 0);
+    const void * key = k0->view_src ? (const void *) k0->view_src : (const void *) k0;
+    ggml_megakernel_desc * d;
+    {
+        std::lock_guard<std::mutex> lock(mtx);
+        auto & slot = descs[key];
+        if (!slot) {
+            slot = std::make_unique<ggml_megakernel_desc>();
+        }
+        {
+            d = slot.get();
+            d->magic = GGML_MEGAKERNEL_MAGIC;
+            d->n_layer = n_layer; d->n_embd = (int32_t) hparams.n_embd; d->n_head = (int32_t) hparams.n_head(0);
+            d->n_vocab = (int32_t) model.output->ne[1];
+            d->eps = hparams.f_norm_rms_eps; d->softcap = hparams.f_final_logit_softcapping;
+            d->embd_scale = sqrtf((float) hparams.n_embd);
+            // llama.cpp keeps tok_embd in host memory for its get_rows; the tied LM head (model.output) is the same Q6_K
+            // table on the GPU, so the kernel's embedding lookup reads that copy
+            const bool same = model.output && model.tok_embd && model.output->type == model.tok_embd->type &&
+                              ggml_are_same_shape(model.output, model.tok_embd);
+            d->tok_embd = same ? model.output : model.tok_embd; d->output_norm = model.output_norm; d->output = model.output;
+            for (int il = 0; il < n_layer; ++il) {
+                const auto & l = model.layers[il];
+                ggml_megakernel_layer & w = d->layers[il];
+                const bool swa = hparams.is_swa(il);
+                if (swa) { d->rope_base_swa = model.get_rope_freq_base(cparams, il); }
+                else     { d->rope_base_full = model.get_rope_freq_base(cparams, il); }
+                w.attn_norm = l.attn_norm; w.attn_q_norm = l.attn_q_norm; w.attn_k_norm = l.attn_k_norm;
+                w.attn_post_norm = l.attn_post_norm; w.ffn_norm = l.ffn_norm; w.ffn_post_norm_1 = l.ffn_post_norm_1;
+                w.ffn_pre_norm_2 = l.ffn_pre_norm_2; w.ffn_post_norm_2 = l.ffn_post_norm_2; w.ffn_post_norm = l.ffn_post_norm;
+                w.out_scale = l.out_scale; w.rope_freqs = swa ? nullptr : l.rope_freqs;
+                w.wq = l.wq; w.wk = l.wk; w.wv = l.wv; w.wo = l.wo;
+                w.ffn_gate = l.ffn_gate; w.ffn_up = l.ffn_up; w.ffn_down = l.ffn_down;
+                w.ffn_gate_inp = l.ffn_gate_inp; w.ffn_gate_inp_s = l.ffn_gate_inp_s;
+                w.ffn_gate_up_exps = l.ffn_gate_up_exps; w.ffn_down_exps = l.ffn_down_exps; w.ffn_down_exps_s = l.ffn_down_exps_s;
+                const auto * kv = swa ? mctx_cur->get_swa() : mctx_cur->get_base();
+                ggml_tensor * k = kv->get_k(ctx0, il);
+                ggml_tensor * v = kv->get_v(ctx0, il);
+                w.k_cache = k->view_src ? k->view_src : k;
+                w.v_cache = v->view_src ? v->view_src : v;
+                w.swa = swa; w.head_dim = (int32_t) hparams.n_embd_head_k(il); w.n_head_kv = (int32_t) hparams.n_head_kv(il);
+            }
+        }
