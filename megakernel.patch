+// Gemma 4 26B A4B decode megakernel (fork, GGML_CUDA_MEGAKERNEL=1).
+// The kernel itself is megakernel-persistent.cuh (helpers in megakernel-common.cuh); this file maps llama.cpp's
+// tensors onto it and launches it.
+#include "megakernel.cuh"
+#include "ggml-megakernel.h"
