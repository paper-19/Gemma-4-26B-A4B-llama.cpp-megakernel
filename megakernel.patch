diff --git a/ggml/include/ggml-megakernel.h b/ggml/include/ggml-megakernel.h
new file mode 100644
index 0000000..3670ed7
--- /dev/null
+++ b/ggml/include/ggml-megakernel.h
@@ -0,0 +1,86 @@
+#pragma once
+
+// Gemma 4 26B A4B decode megakernel (fork: GGML_CUDA_MEGAKERNEL=1).
+//
+// llama.cpp builds, for a single-token decode step, one GGML_OP_CUSTOM node whose userdata points to a
+// ggml_megakernel_desc (model weights, KV cache tensors, constants) and whose sources are the step's inputs:
+//   src[0] token ids (I32 [1])          src[1] positions (I32 [1])
+//   src[2] full-attention KQ mask (F16 [n_kv_full, >=1])   src[3] sliding-window KQ mask (F16 [n_kv_swa, >=1])
+//   src[4] full-attention destination cell (I64 [1])       src[5] sliding-window destination cell (I64 [1])
+//   src[6], src[7] the value-cache cells (unused; keep the inputs allocated)   src[8] output_norm (a GPU weight, for placement)
+// and whose result is the logits (F32 [n_vocab, 1], after the final logit softcapping). The CUDA backend recognises
+// the node by the descriptor's magic and runs the whole step as one persistent kernel; no other backend runs it.
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define GGML_MEGAKERNEL_MAGIC   0x314b4d3441344747ULL   // "GG4A4MK1"
+#define GGML_MEGAKERNEL_LAYERS  30
+
+struct ggml_megakernel_layer {
+    // norms (F32 [n_embd] unless noted)
+    const struct ggml_tensor * attn_norm, * attn_q_norm, * attn_k_norm, * attn_post_norm;   // q/k norm: [head_dim]
+    const struct ggml_tensor * ffn_norm, * ffn_post_norm_1, * ffn_pre_norm_2, * ffn_post_norm_2, * ffn_post_norm;
+    const struct ggml_tensor * out_scale;        // F32 [1]
+    const struct ggml_tensor * rope_freqs;       // F32 [head_dim / 2], full-attention layers only (else NULL)
+    // projections (quantized)
+    const struct ggml_tensor * wq, * wk, * wv;   // wv NULL on full-attention layers (V = K before its norm)
+    const struct ggml_tensor * wo;
+    const struct ggml_tensor * ffn_gate, * ffn_up, * ffn_down;
+    // MoE
+    const struct ggml_tensor * ffn_gate_inp;     // router, F32 [n_embd, n_expert]
+    const struct ggml_tensor * ffn_gate_inp_s;   // router input scale, F32 [n_embd]
+    const struct ggml_tensor * ffn_gate_up_exps; // [n_embd, 2 * n_ff_exp, n_expert]
+    const struct ggml_tensor * ffn_down_exps;    // [n_ff_exp, n_embd, n_expert]
+    const struct ggml_tensor * ffn_down_exps_s;  // F32 [n_expert]
+    // KV cache of this layer (F16 [n_embd_k_gqa, kv_size], one row per cell)
+    const struct ggml_tensor * k_cache, * v_cache;
+    int32_t swa;                                 // 1: sliding-window layer (uses src[3] / src[5])
+    int32_t head_dim, n_head_kv;
+};
+
+struct ggml_megakernel_desc {
+    uint64_t magic;                              // GGML_MEGAKERNEL_MAGIC
+    int32_t  n_layer, n_embd, n_head, n_vocab;
+    float    eps, rope_base_full, rope_base_swa, softcap, embd_scale;
+    const struct ggml_tensor * tok_embd;         // Q6_K [n_embd, n_vocab]
+    const struct ggml_tensor * output_norm;      // F32 [n_embd]
+    const struct ggml_tensor * output;           // LM head (the tied tok_embd for these files)
+    struct ggml_megakernel_layer layers[GGML_MEGAKERNEL_LAYERS];
+};
+
+// The custom op's CPU function (defined by llama.cpp's Gemma 4 builder) is never meant to run: the CUDA backend
+// claims the node (it checks the userdata's magic); it aborts with a message.
+
+// Debug hooks (checking the kernel against stock op by op; a test tool can find these with dlsym).
+// While set, every decode step runs the kernel's debug variant: it records each watch point (llama.cpp's tensor
+// names: Qcur, Qcur_normed, Qcur_pos, Kcur_pos, Vcur_normed, kqv_out, attn_out, ffn_moe_logits, ffn_moe_topk,
+// ffn_mlp, ffn_moe, l_out per layer, then result_norm), replaces the ones selected with supplied values before any
+// consumer reads them, and can plant a fault (fault-injection tests). Buffers are host memory in one layout: per layer
+// `slot` floats, watch point w at offset_w, in ggml's element order; result_norm after the last layer.
+#define GGML_MEGAKERNEL_WATCH_N 12   // per-layer watch points; index GGML_MEGAKERNEL_WATCH_N is result_norm
+
+struct ggml_megakernel_debug {
+    float       * rec;                   // filled after each step (the step synchronizes); ffn_moe_topk as int32
+    const float * rep;                   // replacement values, read before each step
+    uint32_t      rep_mask[GGML_MEGAKERNEL_LAYERS];   // per layer, bit w: replace watch point w (not ffn_moe_topk)
+    int32_t       inj_w, inj_layer;      // planted fault (inj_w < 0: none): v = v * (1 + inj_scale) + inj_rel * rms(v) * noise[i],
+    float         inj_scale, inj_rel;    // rms over the vector, or per head for Q / K / V; kqv_out: scale only
+    const float * noise;                 // unit Gaussian values for the injected watch point
+};
+
+// watch point w (0 .. GGML_MEGAKERNEL_WATCH_N) of layer `layer`: its name (without the layer suffix), its float offset in
+// the buffers and its shape; returns the buffers' total size in floats, or 0 for an invalid w / layer
+GGML_BACKEND_API size_t ggml_megakernel_debug_watch(int w, int layer, const char ** name, size_t * offset, int64_t * ne0, int64_t * ne1);
+// d: the hooks for the following steps (copied; its buffers must stay valid), or NULL to switch them off
+GGML_BACKEND_API void ggml_megakernel_debug_set(const struct ggml_megakernel_debug * d);
+
+#ifdef __cplusplus
+}
+#endif
