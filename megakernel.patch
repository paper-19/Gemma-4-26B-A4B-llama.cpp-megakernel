+static const ggml_megakernel_desc * mk_desc(const ggml_tensor * t) {
+    if (t->op != GGML_OP_CUSTOM) {
+        return nullptr;
+    }
+    const auto * p = (const ggml_custom_op_params *) t->op_params;
+    const auto * d = (const ggml_megakernel_desc *) p->userdata;
+    return d != nullptr && d->magic == GGML_MEGAKERNEL_MAGIC ? d : nullptr;
+}
+
+bool ggml_cuda_megakernel_is_node(const ggml_tensor * t) {
+    return mk_desc(t) != nullptr;
+}
+
+static int mk_wtype(ggml_type t) {
+    switch (t) {
+        case GGML_TYPE_Q4_0: return mk::pk::W_Q4_0;
+        case GGML_TYPE_Q8_0: return mk::pk::W_Q8_0;
+        case GGML_TYPE_Q5_0: return mk::pk::W_Q5_0;
+        case GGML_TYPE_Q4_K: return mk::pk::W_Q4_K;
+        case GGML_TYPE_Q5_K: return mk::pk::W_Q5_K;
+        case GGML_TYPE_Q6_K: return mk::pk::W_Q6_K;
+        default:             return -1;
+    }
+}
+
+bool ggml_cuda_megakernel_supported(const ggml_tensor * t) {
+    const ggml_megakernel_desc * d = mk_desc(t);
+    if (!d) {
+        return false;
+    }
+    if (d->n_layer != mk::NL || d->n_embd != mk::D || d->n_head != mk::NH || t->type != GGML_TYPE_F32 ||
+        t->ne[0] != d->n_vocab || ggml_nrows(t) != 1 || !d->tok_embd || d->tok_embd->type != GGML_TYPE_Q6_K ||
+        !d->output || d->output->type != GGML_TYPE_Q6_K) {
+        return false;
+    }
+    for (int i = 0; i < 9; i++) {
+        if (!t->src[i]) {
+            return false;
+        }
+    }
+    // every tensor the kernel reads directly must be in device memory (all layers offloaded)
+    auto on_device = [](const ggml_tensor * x) { return x == nullptr || (x->buffer && !ggml_backend_buffer_is_host(x->buffer)); };
+    if (!on_device(d->tok_embd) || !on_device(d->output) || !on_device(d->output_norm)) {
+        return false;
+    }
+    if (t->src[2]->type != GGML_TYPE_F16 || t->src[3]->type != GGML_TYPE_F16 ||
+        t->src[4]->type != GGML_TYPE_I64 || t->src[5]->type != GGML_TYPE_I64) {
+        return false;
+    }
+    for (int L = 0; L < mk::NL; L++) {
+        const ggml_megakernel_layer & l = d->layers[L];
+        if (!l.swa && !l.rope_freqs) {   // the kernel's full-attention RoPE divides by rope_freqs
+            return false;
+        }
+        const ggml_tensor * mats[] = { l.wq, l.wk, l.wo, l.ffn_gate, l.ffn_up, l.ffn_down, l.ffn_gate_up_exps, l.ffn_down_exps };
+        for (const ggml_tensor * m : mats) {
+            if (!m || mk_wtype(m->type) < 0) {
+                return false;
+            }
+        }
+        if (l.wv && mk_wtype(l.wv->type) < 0) {
+            return false;
+        }
+        if (!l.k_cache || !l.v_cache || l.k_cache->type != GGML_TYPE_F16 || l.v_cache->type != GGML_TYPE_F16) {
+            return false;
+        }
+        const ggml_tensor * all[] = { l.attn_norm, l.attn_q_norm, l.attn_k_norm, l.attn_post_norm, l.ffn_norm, l.ffn_post_norm_1,
+                                      l.ffn_pre_norm_2, l.ffn_post_norm_2, l.ffn_post_norm, l.out_scale, l.rope_freqs, l.wq, l.wk,
+                                      l.wv, l.wo, l.ffn_gate, l.ffn_up, l.ffn_down, l.ffn_gate_inp, l.ffn_gate_inp_s,
+                                      l.ffn_gate_up_exps, l.ffn_down_exps, l.ffn_down_exps_s, l.k_cache, l.v_cache };
+        for (const ggml_tensor * x : all) {
+            if (!on_device(x)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+struct mk_state {
+    mk::pk::Params P {};
+    size_t smem = 0;
+    int grid = 0;
+    int tc_grid = 0;           // attn_mma_kernel's grid
+    int split_min = 0;         // full-attention cells from which those layers' attention runs in attn_mma_kernel
+    float * rec = nullptr, * rep = nullptr, * noise = nullptr;   // debug hooks' device buffers (allocated on first use)
+    // what the state was made from: the model's weights (repacked copies) and the cache tensors' data (per layer)
+    const void * weights = nullptr;
+    std::vector<mk::pk::Layer> PL;
+    mk::pk::Layer * dPL = nullptr;
+};
+
+// the weights' identity (the tensors' data; the repacked copies were made from it)
+static const void * mk_weights_key(const ggml_megakernel_desc * d) {
+    return d->output->data;
+}
+
+static std::mutex g_mk_mutex;
+static std::map<std::pair<const void *, int>, mk_state *> g_mk_states;
+
+// ---- debug hooks (ggml-megakernel.h)
+static_assert(GGML_MEGAKERNEL_WATCH_N == mk::pk::WP_N, "watch point list");
+static constexpr size_t MK_DBG_N = (size_t) mk::NL * mk::pk::WP_SLOT + mk::D;
+static bool g_mk_dbg_on = false;
+static ggml_megakernel_debug g_mk_dbg;
+
+size_t ggml_megakernel_debug_watch(int w, int layer, const char ** name, size_t * offset, int64_t * ne0, int64_t * ne1) {
+    if (w < 0 || w > GGML_MEGAKERNEL_WATCH_N || (w < GGML_MEGAKERNEL_WATCH_N && (layer < 0 || layer >= mk::NL))) {
+        return 0;
+    }
+    int a = mk::D, b = 1;
+    if (w < GGML_MEGAKERNEL_WATCH_N) {
+        mk::pk::wp_shape(w, layer, a, b);
+    }
+    if (name)   *name   = w < GGML_MEGAKERNEL_WATCH_N ? mk::pk::wp_name(w) : "result_norm";
+    if (offset) *offset = w < GGML_MEGAKERNEL_WATCH_N ? (size_t) layer * mk::pk::WP_SLOT + mk::pk::wp_off(w) : (size_t) mk::NL * mk::pk::WP_SLOT;
+    if (ne0)    *ne0    = a;
+    if (ne1)    *ne1    = b;
+    return MK_DBG_N;
+}
+
+void ggml_megakernel_debug_set(const ggml_megakernel_debug * d) {
+    std::lock_guard<std::mutex> lock(g_mk_mutex);
+    g_mk_dbg_on = d != nullptr;
+    if (d) {
+        g_mk_dbg = *d;
+    }
+}
+
+template <class T> static T * mk_alloc(size_t n, bool zero = true) {
+    T * p = nullptr;
+    CUDA_CHECK(cudaMalloc(&p, n * sizeof(T)));
+    if (zero) {
+        CUDA_CHECK(cudaMemset(p, 0, n * sizeof(T)));
+    }
+    return p;
+}
+
+// a weight matrix as the kernel addresses it; repacked copies (16-byte-aligned layouts) where they measured faster
+static mk::pk::Q4m mk_q4m(const ggml_tensor * t, bool repack, cudaStream_t st) {
+    mk::pk::Q4m m { (const mk::BlockQ4 *) t->data, nullptr, nullptr };
+    m.type = mk_wtype(t->type);
+    const size_t bytes = ggml_nbytes(t);
+    if (repack && m.type == mk::pk::W_Q4_0) {
+        const size_t nb = bytes / sizeof(mk::BlockQ4);
+        uint4 * qs = mk_alloc<uint4>(nb, false); __half * dd = mk_alloc<__half>(nb, false);
+        mk::k_repack_q4_0<<<(nb + 255) / 256, 256, 0, st>>>((const mk::BlockQ4 *) t->data, qs, dd, nb);
+        m.qs = qs; m.d = dd;
+    } else if (repack && m.type == mk::pk::W_Q8_0) {
+        const size_t nb = bytes / 34;
+        uint4 * qs = mk_alloc<uint4>(2 * nb, false); __half * dd = mk_alloc<__half>(nb, false);
+        mk::k_repack_q8_0<<<(nb + 255) / 256, 256, 0, st>>>((const uint8_t *) t->data, qs, dd, nb);
+        m.qs = qs; m.d = dd;
+    } else if (repack && m.type == mk::pk::W_Q5_0) {
+        const size_t nb = bytes / 22;
+        uint4 * qs = mk_alloc<uint4>(nb, false); uint32_t * qh = mk_alloc<uint32_t>(nb, false); __half * dd = mk_alloc<__half>(nb, false);
+        mk::k_repack_q5_0<<<(nb + 255) / 256, 256, 0, st>>>((const uint8_t *) t->data, qs, qh, dd, nb);
+        m.qs = qs; m.qh = qh; m.d = dd;
+    } else if (m.type == mk::pk::W_Q6_K && t->ne[1] >= 65536) {   // the LM head: always repacked (2x on H100)
+        const size_t nb = bytes / 210;
+        uint4 * ql = mk_alloc<uint4>(8 * nb, false); uint4 * qh = mk_alloc<uint4>(4 * nb, false);
+        uint2 * sc = mk_alloc<uint2>(2 * nb, false); __half * dd = mk_alloc<__half>(nb, false);
+        mk::k_repack_q6_k<<<(nb + 255) / 256, 256, 0, st>>>((const uint8_t *) t->data, ql, qh, sc, dd, nb);
+        m.qs = ql; m.qh = (const uint32_t *) qh; m.sc = sc; m.d = dd;
+    }
+    CUDA_CHECK(cudaGetLastError());
+    return m;
+}
+
+static mk_state * mk_init(const ggml_megakernel_desc * d, int device, cudaStream_t st) {
+    mk_state * s = new mk_state();
+    mk::pk::Params & P = s->P;
+    // repacked Q4_0 / Q8_0 / Q5_0 on Hopper (faster there, no gain measured on Ada); GGML_CUDA_MEGAKERNEL_REPACK=0/1 overrides
+    const int cc = ggml_cuda_info().devices[device].cc;
+    bool repack = GGML_CUDA_CC_IS_NVIDIA(cc) && cc >= GGML_CUDA_CC_HOPPER;
+    if (const char * e = getenv("GGML_CUDA_MEGAKERNEL_REPACK")) {
+        repack = atoi(e) != 0;
+    }
+    std::vector<mk::pk::Layer> PL(mk::NL);
+    for (int L = 0; L < mk::NL; L++) {
+        const ggml_megakernel_layer & w = d->layers[L];
+        mk::pk::Layer & l = PL[L];
+        auto f = [](const ggml_tensor * t) { return t ? (const float *) t->data : nullptr; };
+        l.attn_norm = f(w.attn_norm); l.q_norm = f(w.attn_q_norm); l.k_norm = f(w.attn_k_norm); l.post_attn = f(w.attn_post_norm);
+        l.ffn_norm = f(w.ffn_norm); l.post1 = f(w.ffn_post_norm_1); l.pre2 = f(w.ffn_pre_norm_2); l.post2 = f(w.ffn_post_norm_2);
+        l.post_ffw = f(w.ffn_post_norm); l.out_scale = f(w.out_scale);
+        l.router = f(w.ffn_gate_inp); l.router_scale = f(w.ffn_gate_inp_s); l.down_scale = f(w.ffn_down_exps_s);
+        l.wq = mk_q4m(w.wq, repack, st); l.wk = mk_q4m(w.wk, repack, st);
+        l.wv = w.wv ? mk_q4m(w.wv, repack, st) : mk::pk::Q4m { nullptr, nullptr, nullptr };
+        l.wo = mk_q4m(w.wo, repack, st); l.gate = mk_q4m(w.ffn_gate, repack, st); l.up = mk_q4m(w.ffn_up, repack, st);
+        l.down = mk_q4m(w.ffn_down, repack, st); l.gu_exps = mk_q4m(w.ffn_gate_up_exps, repack, st);
+        l.down_exps = mk_q4m(w.ffn_down_exps, repack, st);
+        l.kc = (__half *) w.k_cache->data; l.vc = (__half *) w.v_cache->data; l.rows = 0;
+        l.dk = w.head_dim; l.n_kv = w.n_head_kv; l.full = !w.swa;
+        if (!w.swa && w.rope_freqs) {
+            P.rope_freqs = (const float *) w.rope_freqs->data;
+        }
+    }
+    mk::pk::Layer * dPL = mk_alloc<mk::pk::Layer>(mk::NL, false);
+    CUDA_CHECK(cudaMemcpyAsync(dPL, PL.data(), mk::NL * sizeof(mk::pk::Layer), cudaMemcpyHostToDevice, st));
+    s->weights = mk_weights_key(d); s->PL = PL; s->dPL = dPL;
+    // integer-sum Q4_0 / Q5_0 offset (closer to exact than stock); GGML_CUDA_MEGAKERNEL_ARITH=stock: stock's
+    // arithmetic for those mat-vecs (the correctness gate checks the kernel against stock op by op in this mode)
+    const char * arith = getenv("GGML_CUDA_MEGAKERNEL_ARITH");
+    P.layers = dPL; P.eps = d->eps; P.stock = arith && strcmp(arith, "stock") == 0;
+    P.wo_parts = 1;
+    P.ts_full = powf(d->rope_base_full, -2.0f / 512); P.ts_swa = powf(d->rope_base_swa, -2.0f / 256);
+    P.tok_embd = (const uint8_t *) d->tok_embd->data; P.embd_scale = d->embd_scale;
+    P.lm_head = mk_q4m(d->output, false, st); P.out_norm = (const float *) d->output_norm->data;
+    P.n_vocab = d->n_vocab; P.softcap = d->softcap; P.lm_on = 1;
+    P.kv_ext = 1;
+    using namespace mk;
+    using namespace mk::pk;
+    P.qkv = mk_alloc<float>(QKV_PARTS * QKV_MAX); P.part = mk_alloc<float>((size_t) NH * 80 * 514);
+    P.attq = mk_alloc<BlockQ8>(8192 / 32);
+    P.o = mk_alloc<float>(WO_PARTS * D); P.g = mk_alloc<float>(GU_PARTS * FF); P.u = mk_alloc<float>(GU_PARTS * FF);
+    P.logits = mk_alloc<float>(R_PARTS * NE); P.gu = mk_alloc<float>(NEU * 2 * FFE); P.down = mk_alloc<float>(D);
+    P.moe = mk_alloc<float>(NEU * D); P.l_out = mk_alloc<float>(D);
+    P.bar_count = mk_alloc<unsigned>(1); P.bar_gen = mk_alloc<unsigned>(1); P.head_count = mk_alloc<unsigned>(NH);
+    P.error = mk_alloc<int>(1); P.router_count = mk_alloc<unsigned>(1); P.topk_flag = mk_alloc<int>(1);
+    P.topk_ids = mk_alloc<int>(NEU); P.topk_sc = mk_alloc<float>(NEU);
+    P.argmax = mk_alloc<unsigned long long>(1); P.epoch_dev = mk_alloc<int>(1); P.epoch = 0;
+    // the top-8 flag is matched against epoch * 32 + layer: start it at -1, or the first launch's layer 0 (epoch 0)
+    // would find its value already there and read the expert ids before the router has written them
+    CUDA_CHECK(cudaMemset(P.topk_flag, 0xFF, sizeof(int)));
+    s->smem = smem_bytes();
+    CUDA_CHECK(cudaFuncSetAttribute(step<false>, cudaFuncAttributeMaxDynamicSharedMemorySize, (int) s->smem));
+    CUDA_CHECK(cudaFuncSetAttribute(step<true>, cudaFuncAttributeMaxDynamicSharedMemorySize, (int) s->smem));
+    int per_sm = 0, per_sm_dbg = 0;
+    CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per_sm, step<false>, THREADS, s->smem));
+    CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per_sm_dbg, step<true>, THREADS, s->smem));
+    per_sm = std::min(per_sm, per_sm_dbg);   // one grid for both variants
+    // long contexts: the full-attention layers' attention in its own launch on tensor cores; from
+    // GGML_CUDA_MEGAKERNEL_SPLIT cells on (0: always; default by architecture: H100 gains from ~16k, L40S only near 32k)
+    CUDA_CHECK(cudaFuncSetAttribute(attn_mma_kernel<false>, cudaFuncAttributeMaxDynamicSharedMemorySize, (int) tc_smem_bytes()));
+    CUDA_CHECK(cudaFuncSetAttribute(attn_mma_kernel<true>, cudaFuncAttributeMaxDynamicSharedMemorySize, (int) tc_smem_bytes()));
+    int tc1 = 0, tc2 = 0;
+    CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&tc1, attn_mma_kernel<false>, TC_THREADS, tc_smem_bytes()));
+    CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&tc2, attn_mma_kernel<true>, TC_THREADS, tc_smem_bytes()));
+    s->tc_grid = ggml_cuda_info().devices[device].nsm * std::max(1, std::min(tc1, tc2));
+    s->split_min = cc >= GGML_CUDA_CC_HOPPER ? 12288 : 24576;
+    if (const char * e = getenv("GGML_CUDA_MEGAKERNEL_SPLIT")) {
+        s->split_min = atoi(e);
+    }
+    P.x_save = mk_alloc<float>(D);
+    s->grid = ggml_cuda_info().devices[device].nsm * per_sm;
+    GGML_ASSERT(s->grid > 0 && "megakernel: the persistent kernel does not fit on this device");
+    CUDA_CHECK(cudaStreamSynchronize(st));
+    GGML_LOG_INFO("%s: Gemma 4 decode megakernel: %d SMs x %d blocks, %d threads, %zu B shared, repack %d, %s arithmetic, "
+                  "tensor-core attention from %d cells\n", __func__, ggml_cuda_info().devices[device].nsm, per_sm, THREADS, s->smem,
+                  (int) repack, P.stock ? "stock" : "integer-sum", s->split_min);
+    return s;
+}
+
+void ggml_cuda_megakernel(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_megakernel_desc * d = mk_desc(dst);
+    GGML_ASSERT(d && ggml_cuda_megakernel_supported(dst));
+    cudaStream_t st = ctx.stream();
+    mk_state * s;
+    {
+        std::lock_guard<std::mutex> lock(g_mk_mutex);
+        auto & slot = g_mk_states[{ (const void *) d, ctx.device }];
+        if (slot && slot->weights != mk_weights_key(d)) {   // another model at the same descriptor: start over
+            GGML_LOG_WARN("%s: model changed under a cached megakernel state; rebuilding it (the old one is not freed)\n", __func__);
+            slot = nullptr;
+        }
+        if (!slot) {
+            slot = mk_init(d, ctx.device, st);
+        }
+        s = slot;
+        // a new context can reuse the descriptor (same cache addresses) with other cache memory: follow the cache
+        bool moved = false;
+        for (int L = 0; L < mk::NL; L++) {
+            __half * kc = (__half *) d->layers[L].k_cache->data, * vc = (__half *) d->layers[L].v_cache->data;
+            if (s->PL[L].kc != kc || s->PL[L].vc != vc) {
+                s->PL[L].kc = kc; s->PL[L].vc = vc; moved = true;
+            }
+        }
+        if (moved) {
+            CUDA_CHECK(cudaMemcpyAsync(s->dPL, s->PL.data(), mk::NL * sizeof(mk::pk::Layer), cudaMemcpyHostToDevice, st));
+        }
+    }
+    mk::pk::Params P = s->P;   // the per-step inputs (device copies made by the scheduler)
+    P.token_ptr = (const int *) dst->src[0]->data;
+    P.pos_ptr   = (const int *) dst->src[1]->data;
+    P.mask_full = (const __half *) dst->src[2]->data; P.nkv_full = (int) dst->src[2]->ne[0];
+    P.mask_swa  = (const __half *) dst->src[3]->data; P.nkv_swa  = (int) dst->src[3]->ne[0];
+    P.dst_full  = (const int64_t *) dst->src[4]->data;
+    P.dst_swa   = (const int64_t *) dst->src[5]->data;
+    P.logits_out = (float *) dst->data;
+    P.L0 = 0; P.L1 = mk::NL; P.x_in = nullptr;
+    bool dbg;
+    ggml_megakernel_debug D;
+    {
+        std::lock_guard<std::mutex> lock(g_mk_mutex);
+        dbg = g_mk_dbg_on;
+        D = g_mk_dbg;
+    }
+    if (dbg) {   // the debug variant: records every watch point, replaces the selected ones, plants a fault
+        if (!s->rec) {
+            s->rec = mk_alloc<float>(MK_DBG_N); s->rep = mk_alloc<float>(MK_DBG_N); s->noise = mk_alloc<float>(8192);
+        }
+        bool any = false;
+        for (int L = 0; L < mk::NL; L++) {
+            P.dbg.rep_mask[L] = D.rep_mask[L];
+            any |= D.rep_mask[L] != 0;
+        }
+        GGML_ASSERT((!any || D.rep) && "megakernel debug: replacements without values");
+        if (any) {
+            CUDA_CHECK(cudaMemcpyAsync(s->rep, D.rep, MK_DBG_N * sizeof(float), cudaMemcpyHostToDevice, st));
+        }
+        P.dbg.inj_w = -1;
+        if (D.inj_w >= 0 && D.inj_w < GGML_MEGAKERNEL_WATCH_N && D.noise) {
+            CUDA_CHECK(cudaMemcpyAsync(s->noise, D.noise, mk::pk::wp_size(D.inj_w) * sizeof(float), cudaMemcpyHostToDevice, st));
+            P.dbg.inj_w = D.inj_w; P.dbg.inj_layer = D.inj_layer; P.dbg.inj_scale = D.inj_scale; P.dbg.inj_rel = D.inj_rel;
+        }
+        P.dbg.rec = s->rec; P.dbg.rep = s->rep; P.dbg.noise = s->noise;
+    }
+    const bool split = P.nkv_full >= s->split_min;
+    CUDA_CHECK(mk::pk::launch_layers(P, split, dbg, s->grid, 0, st, s->tc_grid));
+    if (dbg && D.rec) {
+        CUDA_CHECK(cudaMemcpyAsync(D.rec, s->rec, MK_DBG_N * sizeof(float), cudaMemcpyDeviceToHost, st));
+        CUDA_CHECK(cudaStreamSynchronize(st));
+    }
+}
