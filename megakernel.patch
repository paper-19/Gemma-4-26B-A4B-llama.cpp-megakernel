+// ---- decode megakernel (fork): GGML_CUDA_MEGAKERNEL=1 builds a single-token step as one custom op that the CUDA
+// backend runs as one persistent kernel (see ggml/include/ggml-megakernel.h); anything else builds the usual graph
+
+static bool gemma4_megakernel_enabled() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_CUDA_MEGAKERNEL");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    return on;
+}
+
+static void gemma4_megakernel_cpu(ggml_tensor *, int, int, void *) {
+    GGML_ABORT("GGML_CUDA_MEGAKERNEL: the decode megakernel runs only on a CUDA device with the whole model offloaded");
+}
+
+// the token ids, without the embedding lookup (the kernel does it)
+class llm_graph_input_mk_tokens : public llm_graph_input_i {
+public:
+    void set_input(const llama_ubatch * ubatch) override {
+        GGML_ASSERT(ubatch->token && "GGML_CUDA_MEGAKERNEL: token input only");
+        ggml_backend_tensor_set(tokens, ubatch->token, 0, ggml_nbytes(tokens));
